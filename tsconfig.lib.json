{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "declarationDir": "dist/types",
    "rootDir": "src"
  },
  "include": [
    "src/cesium-three-ground.ts",
    "src/cesium-source-modules.d.ts",
    "src/earcut-module.d.ts",
    "src/lib/arrow/**/*.ts",
    "src/lib/ground/**/*.ts",
    "src/lib/plot/**/*.ts"
  ],
  "exclude": [
    "src/demo/**",
    "src/main.ts"
  ]
}
