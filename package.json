{
  "name": "cesium-to-three",
  "version": "0.1.8",
  "type": "module",
  "description": "Cesium-style ground primitives for Three.js.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/cesium-three-ground.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/cesium-three-ground.d.ts",
      "import": "./dist/index.js"
    },
    "./ground": {
      "types": "./dist/types/lib/ground/index.d.ts",
      "import": "./dist/ground.js"
    },
    "./arrow": {
      "types": "./dist/types/lib/arrow/index.d.ts",
      "import": "./dist/arrow.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json --emitDeclarationOnly",
    "prepack": "npm run build:lib",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "earcut": "^3.0.2",
    "mersenne-twister": "^1.1.0",
    "polygon-clipping": "^0.15.7",
    "rbush": "^4.0.1",
    "three": "^0.183.0",
    "um-3d-tiles-renderer": "^0.4.48",
    "urijs": "^1.19.11"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/three": "^0.183.0",
    "lil-gui": "^0.19.2",
    "typescript": "~5.3.0",
    "vite": "^5.0.0"
  }
}
