# ============================================================
# .env.example
# 用法:复制为 .env.local，填入你自己的 Cesium Ion access token
#      token 永远不要提交到 git
#
# 获取 Token:
#   1. 注册 https://cesium.com/ion/ 免费账号
#   2. 到 https://cesium.com/ion/tokens 创建 token
#   3. 默认权限通常包含 "Cesium World Terrain"(assetId=1)
#      与 "Cesium World Bathymetry"(assetId=2275207)
# ============================================================

# 必填。Cesium Ion access token，形如 eyJhbGciO...
VITE_CESIUM_ION_TOKEN=

# 可选。要加载的 Cesium Ion asset id。
# 默认 96188 = Cesium World Terrain(地形，无影像)
# 推荐值:
#   1       - 旧版 Cesium World Terrain(已弃用，可能返回 410)
#   96188   - Cesium World Terrain(当前推荐)
#   2275207 - Cesium World Bathymetry(含水下地形)
#   354759  - Google Photorealistic 3D Tiles(需要额外 API key)
VITE_CESIUM_ION_ASSET_ID=96188

# 可选。Demo 红色矩形的中心经纬度。默认在上海陆家嘴附近。
VITE_PLOT_LON=121.5
VITE_PLOT_LAT=31.24
VITE_PLOT_WIDTH_METERS=10
VITE_PLOT_HEIGHT_METERS=10
VITE_DEBUG_GROUND_SURFACE=false
